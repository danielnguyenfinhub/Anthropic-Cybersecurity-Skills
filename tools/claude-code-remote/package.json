{
  "name": "claude-code-remote",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that schedules a message to be delivered back to a Claude Code session later (self check-ins), plus a worker that wakes the session when a job is due.",
  "type": "module",
  "bin": {
    "claude-code-remote-server": "dist/server.js",
    "claude-code-remote-worker": "dist/worker.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:server": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "dev:server": "node --experimental-strip-types src/server.ts",
    "dev:worker": "node --experimental-strip-types src/worker.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "better-sqlite3": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
